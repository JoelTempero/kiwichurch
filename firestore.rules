rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the current user's document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Check if user is a host
    function isHost() {
      return isAuthenticated() && getUserData().role == 'host';
    }

    // Check if user is admin or host
    function isAdminOrHost() {
      return isAdmin() || isHost();
    }

    // Check if user is permitted to post Kete
    function canPostKete() {
      let data = getUserData();
      return isAdminOrHost() ||
        (data.keys().hasAny(['canPostKete']) && data.canPostKete == true);
    }

    // Check if user account is active and approved.
    // Existing users without a status field are treated as 'active' for
    // backwards compatibility. Self-signup writes status: 'pending', which
    // blocks writes until an admin/host flips it to 'active'.
    function isActive() {
      let data = getUserData();
      return !data.keys().hasAny(['status']) ||
        (data.status != 'deactivated' && data.status != 'pending');
    }

    // Check if user is a member of a specific gathering
    function isMemberOfGathering(gatheringId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/gatherings/$(gatheringId)/members/$(request.auth.uid));
    }

    // Check if user is host of a specific gathering.
    // Two equivalent paths: the gathering names them via hostId (legacy
    // single-host model), OR the user's hostedGatherings array includes
    // this gathering (admin-assigned multi-host model).
    function isHostOfGathering(gatheringId) {
      let data = getUserData();
      return isAuthenticated() && (
        get(/databases/$(database)/documents/gatherings/$(gatheringId)).data.hostId == request.auth.uid ||
        (data.keys().hasAny(['hostedGatherings']) && gatheringId in data.hostedGatherings)
      );
    }

    // Check if a gathering is public
    function isPublicGathering(gatheringId) {
      let gathering = get(/databases/$(database)/documents/gatherings/$(gatheringId)).data;
      return gathering.isPublic == true;
    }

    // Check if this is the initial setup (no setup doc exists)
    function isInitialSetup() {
      return !exists(/databases/$(database)/documents/settings/setup);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    // The /users doc holds the source-of-truth PII (email, phone, dependants,
    // privacy map). It is NOT readable by other members — they read the
    // public-visible /userProfiles mirror instead. Members can read their own
    // doc; admin/host can read everyone for moderation and pastoral care.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdminOrHost()
      );

      // Users can create their own profile during registration.
      // Self-signup must land as status: 'pending' (admin approval required).
      // During initial setup, the first user is allowed to be 'admin' + 'active'.
      // Admins can create documents for other users (status: 'active' default).
      allow create: if isAuthenticated() &&
        (
          // Self-create: pending only (or admin on initial setup)
          (request.auth.uid == userId && (
            (isInitialSetup() && request.resource.data.role == 'admin') ||
            (request.resource.data.role == 'member' &&
             request.resource.data.status == 'pending')
          )) ||
          // Admin creates another user's document
          isAdmin()
        );

      // Users can update their own profile (limited fields). Pending users
      // can still update their own profile so they can fill in details
      // while awaiting approval, but isActive() gating elsewhere blocks
      // their writes to community content.
      // hostedGatherings is intentionally NOT in this list — only admins
      // can assign host scope (handled by the admin update rule below).
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        getUserData().status != 'deactivated' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'bio', 'photoURL', 'preferences', 'privacy', 'interests', 'gallery', 'dependants', 'updatedAt']);

      // Admins can update any user (including role)
      allow update: if isAdmin();

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // Public user profiles — the privacy-filtered mirror that the directory,
    // DM picker, and search panel read. Self-written; the server cannot
    // verify the mirror matches the source doc, but the user wrote both
    // sides, so the trust boundary is the same as for /users self-update.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId || isAdminOrHost()
      );
    }

    // ============================================
    // GATHERINGS COLLECTION
    // ============================================
    match /gatherings/{gatheringId} {
      // All authenticated users can read gatherings
      allow read: if isAuthenticated();

      // Admins can create/update/delete gatherings
      // During initial setup, allow creation
      allow create: if isAdmin() || isInitialSetup();
      allow update, delete: if isAdmin();

      // Gathering members subcollection
      match /members/{memberId} {
        // Any authenticated user can see who's in a group
        allow read: if isAuthenticated();

        // Users can join groups themselves; admin/host can add others
        // (host-of-this-gathering, not any host).
        allow create: if isAuthenticated() && isActive() && (
          request.auth.uid == memberId ||
          isAdmin() ||
          isHostOfGathering(gatheringId)
        );

        // Users can leave (delete own doc), hosts/admins can remove anyone
        allow delete: if isAuthenticated() &&
          (request.auth.uid == memberId || isHostOfGathering(gatheringId) || isAdminOrHost());

        // Admins and gathering hosts can update member records
        allow update: if isHostOfGathering(gatheringId) || isAdminOrHost();
      }

      // Posts within a gathering's message board
      match /posts/{postId} {
        // Read based on gathering visibility
        allow read: if isAuthenticated() &&
          (isPublicGathering(gatheringId) || isMemberOfGathering(gatheringId) || isAdmin());

        // During initial setup, allow seeding posts
        allow create: if isInitialSetup() ||
          (isAuthenticated() && isActive() &&
           request.resource.data.authorId == request.auth.uid &&
           (isPublicGathering(gatheringId) || isMemberOfGathering(gatheringId)));

        // Authors can update their own posts
        allow update: if isAuthenticated() && isActive() &&
          (resource.data.authorId == request.auth.uid || isAdmin());

        // Authors and admins can delete posts
        allow delete: if isAuthenticated() &&
          (resource.data.authorId == request.auth.uid || isAdmin());

        // Comments on posts
        match /comments/{commentId} {
          allow read: if isAuthenticated() &&
            (isPublicGathering(gatheringId) || isMemberOfGathering(gatheringId) || isAdmin());

          allow create: if isInitialSetup() ||
            (isAuthenticated() && isActive() &&
             request.resource.data.authorId == request.auth.uid &&
             (isPublicGathering(gatheringId) || isMemberOfGathering(gatheringId)));

          allow update, delete: if isAuthenticated() &&
            (resource.data.authorId == request.auth.uid || isAdmin());
        }
      }

      // Group resources (files + links)
      match /resources/{resourceId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isActive();
        allow update: if isAuthenticated() && isActive()
          && (resource.data.uploadedBy == request.auth.uid || isAdmin());
        allow delete: if isAuthenticated() && isActive()
          && (resource.data.uploadedBy == request.auth.uid || isAdmin() || isHost());
      }
    }

    // ============================================
    // EVENTS COLLECTION
    // ============================================
    match /events/{eventId} {
      // Public events readable by anyone (static site calendar); all events readable by authenticated users
      allow read: if isAuthenticated() || resource.data.isPublic == true;

      // Admin can create/edit/delete any event (incl. church-wide events
      // with no gatheringId). Hosts can only act on events for groups
      // they've been assigned to.
      allow create: if isAdmin() ||
        (isHost() && request.resource.data.gatheringId is string &&
         request.resource.data.gatheringId != '' &&
         isHostOfGathering(request.resource.data.gatheringId));

      allow update: if isAdmin() ||
        (isHost() && resource.data.gatheringId is string &&
         resource.data.gatheringId != '' &&
         isHostOfGathering(resource.data.gatheringId));

      // Only admins can delete events (matches existing behaviour for now).
      allow delete: if isAdmin() ||
        (isHost() && resource.data.gatheringId is string &&
         resource.data.gatheringId != '' &&
         isHostOfGathering(resource.data.gatheringId));

      // RSVPs subcollection
      match /rsvps/{rsvpId} {
        // Users can read all RSVPs for an event
        allow read: if isAuthenticated();

        // Users can create/update their own RSVP
        allow create, update: if isAuthenticated() && request.auth.uid == rsvpId;

        // Users can delete their own RSVP
        allow delete: if isAuthenticated() && request.auth.uid == rsvpId;
      }
    }

    // ============================================
    // KETE (BLOG) COLLECTION
    // ============================================
    match /kete/{postId} {
      // Published posts are publicly readable (static site fetches anonymously).
      // Drafts: only the author and admin/host.
      allow read: if resource.data.published == true ||
        (isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          isAdminOrHost()
        ));

      // Permitted users can create posts authored by themselves.
      // Initial setup is allowed (seed data).
      allow create: if isInitialSetup() ||
        (canPostKete() && isActive() && request.resource.data.authorId == request.auth.uid);

      // Authors can update their own posts; admins/hosts can update any.
      allow update: if isAuthenticated() && isActive() && (
        resource.data.authorId == request.auth.uid || isAdminOrHost()
      );

      // Authors can delete their own posts; admins/hosts can delete any.
      allow delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid || isAdminOrHost()
      );

      // Comments on kete posts (unchanged from previous rules)
      match /comments/{commentId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() && isActive() &&
          request.resource.data.authorId == request.auth.uid;

        allow update, delete: if isAuthenticated() &&
          (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // ============================================
    // MESSAGE BOARDS COLLECTION
    // ============================================
    match /messageBoards/{boardId} {
      // Board structure: boardId = gatheringId

      // Read access based on gathering type
      allow read: if isAuthenticated() &&
        (isPublicGathering(boardId) || isMemberOfGathering(boardId) || isAdmin());

      // Only admins can create/delete boards
      allow create, delete: if isAdmin();

      // Posts within a message board
      match /posts/{postId} {
        // Read based on gathering visibility
        allow read: if isAuthenticated() &&
          (isPublicGathering(boardId) || isMemberOfGathering(boardId) || isAdmin());

        // For PUBLIC gatherings: any authenticated user can post
        // For PRIVATE gatherings: only members can post
        allow create: if isAuthenticated() && isActive() &&
          request.resource.data.authorId == request.auth.uid &&
          (isPublicGathering(boardId) || isMemberOfGathering(boardId));

        // Authors can update their own posts
        allow update: if isAuthenticated() && isActive() &&
          (resource.data.authorId == request.auth.uid || isAdmin());

        // Authors and admins can delete posts
        allow delete: if isAuthenticated() &&
          (resource.data.authorId == request.auth.uid || isAdmin());

        // Comments on posts
        match /comments/{commentId} {
          allow read: if isAuthenticated() &&
            (isPublicGathering(boardId) || isMemberOfGathering(boardId) || isAdmin());

          allow create: if isAuthenticated() && isActive() &&
            request.resource.data.authorId == request.auth.uid &&
            (isPublicGathering(boardId) || isMemberOfGathering(boardId));

          allow update, delete: if isAuthenticated() &&
            (resource.data.authorId == request.auth.uid || isAdmin());
        }
      }
    }

    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Authenticated users can create notifications for others (mentions, DMs)
      allow create: if isAuthenticated() && isActive() &&
        request.resource.data.userId != request.auth.uid;

      // Users can mark their notifications as read
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // SITE SETTINGS (Admin only)
    // ============================================
    match /settings/{settingId} {
      allow read: if true; // Public settings readable
      // Allow creating setup document during initial setup to lock it down
      allow create: if isInitialSetup() && settingId == 'setup';
      allow write: if isAdmin();
    }

    // ============================================
    // REPORTS (Content Moderation)
    // ============================================
    match /reports/{reportId} {
      // Admins and hosts can read all reports
      allow read: if isAdminOrHost();

      // Any authenticated user can create a report
      allow create: if isAuthenticated() && isActive() &&
        request.resource.data.reporterId == request.auth.uid;

      // Only admins can update report status
      allow update: if isAdmin();

      // Only admins can delete reports
      allow delete: if isAdmin();
    }

    // ============================================
    // CONVERSATIONS (Direct Messages)
    // ============================================
    match /conversations/{conversationId} {
      // Only participants can read
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participantIds;

      // Authenticated users can create conversations they participate in
      allow create: if isAuthenticated() && isActive() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;

      // Participants can update (lastMessage, lastReadAt, updatedAt)
      allow update: if isAuthenticated() && isActive() &&
        request.auth.uid in resource.data.participantIds;

      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        // Participants can send messages as themselves
        allow create: if isAuthenticated() && isActive() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.senderId == request.auth.uid;

        // Authors can update/delete their own messages
        allow update, delete: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
      }
    }

    // ============================================
    // USERNAMES COLLECTION (for username lookup)
    // ============================================
    match /usernames/{username} {
      // Anyone can check if username exists
      allow read: if true;

      // Users can claim unclaimed usernames
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid;

      // Only the owner can delete their username
      allow delete: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
    }

    // ============================================
    // FAMILY LINKS (account-to-account family relations)
    // ============================================
    // Doc id is [senderId, recipientId].sort().join('_'). Two states:
    // 'pending' (sender invited, recipient hasn't responded) and
    // 'accepted' (both confirmed). Either party can delete the doc to
    // break the link or decline a pending invite.
    match /familyLinks/{linkId} {
      allow read: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;

      // Sender creates a pending invite. They must be one of the
      // participants and the sender. Recipient must be a different user.
      // Optional `relationship` and name fields ride along.
      allow create: if isAuthenticated() && isActive() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId != request.auth.uid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        (!request.resource.data.keys().hasAny(['relationship']) ||
         request.resource.data.relationship is string);

      // Recipient accepts: flip status to 'accepted'. Other fields stay.
      allow update: if isAuthenticated() && isActive() &&
        request.auth.uid == resource.data.recipientId &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt']);

      // Either party can edit the relationship label on an accepted link.
      allow update: if isAuthenticated() && isActive() &&
        request.auth.uid in resource.data.participants &&
        resource.data.status == 'accepted' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['relationship']);

      // Either party can delete — cancels a pending invite, declines an
      // incoming one, or removes an existing link.
      allow delete: if isAuthenticated() &&
        request.auth.uid in resource.data.participants;
    }

    // ============================================
    // CONTACT MESSAGES (public website form)
    // ============================================
    match /contactMessages/{messageId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
        request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'read', 'website']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() < 200 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() < 200 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() < 5000 &&
        (!request.resource.data.keys().hasAny(['website']) || request.resource.data.website == '');
      allow read, update, delete: if isAuthenticated() && isAdmin();
    }
  }
}
