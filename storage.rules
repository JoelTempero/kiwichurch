rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check file size (in bytes)
    function isValidSize(maxSizeMB) {
      return request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // Check if file is an image
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Check if file is a document (PDF, DOC, etc)
    function isDocument() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*');
    }

    // Check if file is allowed type (image or document)
    function isAllowedType() {
      return isImage() || isDocument();
    }

    // ============================================
    // USER PROFILE IMAGES
    // ============================================
    match /users/{userId}/profile/{fileName} {
      // Anyone authenticated can view profile images
      allow read: if isAuthenticated();

      // Users can upload their own profile image
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isImage() &&
        isValidSize(5); // Max 5MB
    }

    // User personal gallery — images shown on member profile
    match /users/{userId}/gallery/{fileName} {
      allow read: if isAuthenticated();

      // Users can upload to their own gallery
      allow write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isImage() &&
        isValidSize(8);

      // Users can delete their own gallery items
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // ============================================
    // KETE (BLOG) IMAGES
    // ============================================
    match /kete/{postId}/{fileName} {
      // Public — Kete posts are public, so their images must be too.
      // (Storage rules can't query Firestore to check post.published,
      // so all kete images are publicly readable. Drafts that link to
      // these images are private at the Firestore level.)
      allow read: if true;

      // Any authenticated user can write image bytes within size limits.
      // Firestore rules gate post creation via canPostKete — that's the
      // real permission gate. Images uploaded without a matching post
      // doc become orphans (admin sweep deferred).
      allow write: if isAuthenticated() &&
        isImage() &&
        isValidSize(10);

      // Client-side deletes blocked. Admins delete via Firebase Console
      // for now; revisit when Cloud Functions are added.
      allow delete: if false;
    }

    // ============================================
    // EVENT IMAGES
    // ============================================
    match /events/{eventId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
        isImage() &&
        isValidSize(10);

      allow delete: if false;
    }

    // ============================================
    // GATHERING IMAGES
    // ============================================
    match /gatherings/{gatheringId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
        isImage() &&
        isValidSize(10);

      allow delete: if false;
    }

    // ============================================
    // GROUP RESOURCES (files uploaded to group library)
    // ============================================
    match /gatherings/{gatheringId}/resources/{resourceId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && isAllowedType()
        && isValidSize(25);
      allow delete: if isAuthenticated();
    }

    // ============================================
    // MESSAGE BOARD ATTACHMENTS
    // ============================================
    match /messageBoards/{boardId}/posts/{postId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated() &&
        isAllowedType() &&
        isValidSize(25);

      allow delete: if false;
    }

    // ============================================
    // SHARED RESOURCES
    // ============================================
    match /resources/{fileName} {
      allow read: if true;

      allow write: if isAuthenticated() &&
        isAllowedType() &&
        isValidSize(50);

      allow delete: if false;
    }

    // ============================================
    // TEMPORARY UPLOADS
    // ============================================
    match /temp/{userId}/{fileName} {
      // Users can manage their own temp files
      allow read, write: if isAuthenticated() &&
        request.auth.uid == userId &&
        isAllowedType() &&
        isValidSize(25);

      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
