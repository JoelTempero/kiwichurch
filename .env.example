# Copy this file to `.env` for local development.
# Production Firebase config is hardcoded in src/services/firebase/config.ts
# (the web SDK keys are not secrets; App Check is the actual abuse gate).

# Point the app at the local emulator suite (firebase emulators:start)
# instead of production Firebase. Leave unset / false to talk to prod.
VITE_USE_EMULATORS=false

# Optional: FCM Web Push certificate public key (Firebase Console → Cloud
# Messaging → Web Push certificates). Leave blank to use FCM's default key.
VITE_FIREBASE_VAPID_KEY=
